{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxCtrl",
  "version": "0.5.0",
  "identifier": "ai.voxctrl.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cargo build --bin voxctrl-overlay && node scripts/prepare-sidecar.mjs && npm run dev",
    "beforeBuildCommand": "cargo build --bin voxctrl-overlay --release && node scripts/prepare-sidecar.mjs && npm run build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "settings",
        "title": "VoxCtrl Settings",
        "width": 880,
        "height": 1000,
        "minWidth": 720,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "closable": true,
        "acceptFirstMouse": true,
        "url": "/settings"
      },
      {
        "label": "wizard",
        "title": "VoxCtrl — First-Run Setup",
        "width": 1500,
        "height": 1040,
        "minWidth": 1374,
        "minHeight": 1000,
        "center": true,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "acceptFirstMouse": true,
        "url": "/wizard"
      },
      {
        "label": "udev-warning",
        "title": "VoxCtrl Setup",
        "width": 580,
        "height": 600,
        "minWidth": 480,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "resizable": true,
        "url": "/udev-warning"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/voxctrl-overlay"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libssl3",
          "libayatana-appindicator3-1",
          "wtype | xdotool",
          "wl-clipboard | xclip"
        ]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
